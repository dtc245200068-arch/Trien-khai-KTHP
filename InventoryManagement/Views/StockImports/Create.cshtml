@model InventoryManagement.ViewModels.StockImportCreateViewModel

@{
    ViewData["Title"] = "Nhập kho";
}

<style>
    .import-card {
        background: #fff;
        border: 1px solid #e7e5e4;
        border-radius: 18px;
        padding: 28px;
    }

    .import-title {
        font-size: 20px;
        font-weight: 800;
        color: #292524;
        margin-bottom: 5px;
    }

    .import-subtitle {
        color: #78716c;
        font-size: 13px;
        margin-bottom: 25px;
    }

    .top-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 25px;
    }

    .form-label {
        display: block;
        margin-bottom: 7px;
        font-size: 12px;
        font-weight: 700;
        color: #44403c;
    }

    .form-control-custom {
        width: 100%;
        padding: 11px 13px;
        border: 1px solid #e7e5e4;
        border-radius: 10px;
        outline: none;
        background: #fff;
    }

    .form-control-custom:focus {
        border-color: #c96f32;
    }

    .section-title {
        margin: 25px 0 12px;
        font-size: 14px;
        font-weight: 800;
        color: #292524;
    }

    .items-table {
        width: 100%;
        border-collapse: collapse;
    }

    .items-table th {
        padding: 11px;
        background: #fafaf9;
        color: #78716c;
        font-size: 11px;
        text-align: left;
    }

    .items-table td {
        padding: 10px;
        border-top: 1px solid #f5f5f4;
        vertical-align: middle;
    }

    .product-select {
        min-width: 260px;
    }

    .quantity-input {
        width: 110px;
    }

    .price-input {
        width: 180px;
    }

    .amount-cell {
        min-width: 150px;
        font-weight: 700;
        color: #292524;
    }

    .btn-remove {
        border: 1px solid #fecaca;
        background: #fff;
        color: #dc2626;
        border-radius: 8px;
        padding: 7px 10px;
        cursor: pointer;
    }

    .btn-add-row {
        margin-top: 15px;
        border: 1px dashed #c96f32;
        background: #fff7ed;
        color: #c96f32;
        border-radius: 10px;
        padding: 9px 14px;
        font-weight: 700;
        cursor: pointer;
    }

    .summary {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
    }

    .summary-box {
        min-width: 300px;
        padding: 18px;
        border-radius: 14px;
        background: #fafaf9;
        border: 1px solid #e7e5e4;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .total-value {
        color: #c96f32;
        font-size: 20px;
        font-weight: 800;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 25px;
    }

    .btn-back,
    .btn-save {
        padding: 11px 18px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    .btn-back {
        border: 1px solid #e7e5e4;
        color: #57534e;
        background: white;
    }

    .btn-save {
        border: none;
        background: #c96f32;
        color: white;
        cursor: pointer;
    }

    .validation-summary {
        margin-bottom: 18px;
        padding: 12px 15px;
        border-radius: 10px;
        background: #fef2f2;
        color: #b91c1c;
        font-size: 12px;
    }
</style>

<div class="import-card">

    <div class="import-title">
        Tạo phiếu nhập kho
    </div>

    <div class="import-subtitle">
        Chọn nhà cung cấp và các sản phẩm cần nhập vào kho.
    </div>

    <form asp-action="Create"
          method="post"
          id="importForm">

        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All"
                 class="validation-summary"></div>
        }

        <div class="top-grid">

            <div>
                <label class="form-label">
                    Nhà cung cấp *
                </label>

                <select asp-for="SupplierId"
                        class="form-control-custom">

                    <option value="">
                        -- Chọn nhà cung cấp --
                    </option>

                    @foreach (var supplier in Model.Suppliers)
                    {
                        <option value="@supplier.Id">
                            @supplier.Name
                        </option>
                    }

                </select>

                <span asp-validation-for="SupplierId"
                      style="color:#dc2626;font-size:11px;"></span>
            </div>

            <div>
                <label class="form-label">
                    Ghi chú
                </label>

                <input asp-for="Note"
                       class="form-control-custom"
                       placeholder="Ví dụ: Nhập hàng tháng 10..." />
            </div>

        </div>

        <div class="section-title">
            Chi tiết hàng nhập
        </div>

        <div style="overflow-x:auto;">

            <table class="items-table">

                <thead>
                    <tr>
                        <th>SẢN PHẨM</th>
                        <th>SỐ LƯỢNG</th>
                        <th>GIÁ NHẬP</th>
                        <th>THÀNH TIỀN</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody id="itemsBody">
                </tbody>

            </table>

        </div>

        <button type="button"
                class="btn-add-row"
                onclick="addRow()">
            + Thêm sản phẩm
        </button>

        <div class="summary">

            <div class="summary-box">

                <div class="summary-row">
                    <span>Tổng tiền phiếu nhập</span>

                    <span class="total-value"
                          id="grandTotal">
                        0 đ
                    </span>
                </div>

            </div>

        </div>

        <div class="form-actions">

            <a asp-action="Index"
               class="btn-back">
                Quay lại
            </a>

            <button type="submit"
                    class="btn-save">
                Lưu phiếu nhập
            </button>

        </div>

    </form>

</div>

<script>
    const products = [
        @foreach (var product in Model.Products)
        {
            <text>
            {
                id: @product.Id,
                code: '@Html.Raw(product.Code.Replace("'", "\\'"))',
                name: '@Html.Raw(product.Name.Replace("'", "\\'"))',
                price: @product.ImportPrice.ToString(
                    System.Globalization.CultureInfo.InvariantCulture)
            },
            </text>
        }
    ];

    let rowIndex = 0;

    function addRow() {
        const tbody = document.getElementById("itemsBody");

        const tr = document.createElement("tr");

        tr.innerHTML = `
            <td>
                <select
                    name="Items[${rowIndex}].ProductId"
                    class="form-control-custom product-select"
                    onchange="productChanged(this)">

                    <option value="0">
                        -- Chọn sản phẩm --
                    </option>

                    ${products.map(p =>
                        `<option value="${p.id}"
                                 data-price="${p.price}">
                            ${p.code} - ${p.name}
                         </option>`
                    ).join("")}

                </select>
            </td>

            <td>
                <input
                    name="Items[${rowIndex}].Quantity"
                    type="number"
                    value="1"
                    min="1"
                    class="form-control-custom quantity-input"
                    oninput="calculateRow(this)" />
            </td>

            <td>
                <input
                    name="Items[${rowIndex}].UnitPrice"
                    type="number"
                    value="0"
                    min="0"
                    step="0.01"
                    class="form-control-custom price-input"
                    oninput="calculateRow(this)" />
            </td>

            <td class="amount-cell">
                0 đ
            </td>

            <td>
                <button
                    type="button"
                    class="btn-remove"
                    onclick="removeRow(this)">
                    Xóa
                </button>
            </td>
        `;

        tbody.appendChild(tr);

        rowIndex++;
    }

    function productChanged(select) {
        const row = select.closest("tr");

        const option =
            select.options[select.selectedIndex];

        const price =
            option.getAttribute("data-price") || 0;

        const priceInput =
            row.querySelector(".price-input");

        priceInput.value = price;

        calculateRow(priceInput);
    }

    function calculateRow(element) {
        const row = element.closest("tr");

        const quantity =
            parseFloat(
                row.querySelector(".quantity-input").value
            ) || 0;

        const price =
            parseFloat(
                row.querySelector(".price-input").value
            ) || 0;

        const amount = quantity * price;

        row.querySelector(".amount-cell").innerText =
            formatMoney(amount);

        calculateTotal();
    }

    function calculateTotal() {
        let total = 0;

        document
            .querySelectorAll("#itemsBody tr")
            .forEach(row => {

                const quantity =
                    parseFloat(
                        row.querySelector(".quantity-input").value
                    ) || 0;

                const price =
                    parseFloat(
                        row.querySelector(".price-input").value
                    ) || 0;

                total += quantity * price;
            });

        document.getElementById("grandTotal").innerText =
            formatMoney(total);
    }

    function removeRow(button) {
        button.closest("tr").remove();

        calculateTotal();
    }

    function formatMoney(value) {
        return new Intl.NumberFormat("vi-VN")
            .format(value) + " đ";
    }

    // Tạo sẵn một dòng khi mở trang
    document.addEventListener(
        "DOMContentLoaded",
        function () {
            addRow();
        }
    );
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
