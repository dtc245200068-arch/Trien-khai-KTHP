@model InventoryManagement.Models.StockImport

@{
    ViewData["Title"] = "Chi tiết phiếu nhập";
}

<style>
    .detail-card {
        background: white;
        border: 1px solid #e7e5e4;
        border-radius: 18px;
        padding: 25px;
    }

    .receipt-head {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 20px;
        border-bottom: 1px solid #f5f5f4;
    }

    .receipt-code {
        color: #c96f32;
        font-size: 21px;
        font-weight: 800;
    }

    .receipt-info {
        margin-top: 7px;
        color: #78716c;
        font-size: 13px;
    }

    .total {
        text-align: right;
    }

    .total strong {
        display: block;
        margin-top: 5px;
        color: #c96f32;
        font-size: 21px;
    }

    .detail-table {
        width: 100%;
        margin-top: 22px;
        border-collapse: collapse;
    }

    .detail-table th {
        padding: 12px;
        background: #fafaf9;
        color: #78716c;
        font-size: 11px;
        text-align: left;
    }

    .detail-table td {
        padding: 13px 12px;
        border-top: 1px solid #f5f5f4;
        font-size: 12px;
    }

    .actions {
        margin-top: 22px;
    }

    .btn-back {
        display: inline-block;
        padding: 9px 15px;
        border: 1px solid #e7e5e4;
        border-radius: 9px;
        color: #57534e;
        text-decoration: none;
    }

    .success {
        padding: 12px 15px;
        margin-bottom: 18px;
        border: 1px solid #bbf7d0;
        border-radius: 10px;
        background: #f0fdf4;
        color: #166534;
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="success">
        ✓ @TempData["Success"]
    </div>
}

<div class="detail-card">

    <div class="receipt-head">

        <div>

            <div class="receipt-code">
                @Model.Code
            </div>

            <div class="receipt-info">
                Nhà cung cấp:
                <strong>
                    @(Model.Supplier?.Name ?? "-")
                </strong>
            </div>

            <div class="receipt-info">
                Ngày nhập:
                @Model.ImportDate.ToString("dd/MM/yyyy HH:mm")
            </div>

            <div class="receipt-info">
                Người tạo:
                @(Model.CreatedBy ?? "-")
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <div class="receipt-info">
                    Ghi chú: @Model.Note
                </div>
            }

        </div>

        <div class="total">
            Tổng giá trị
            <strong>
                @Model.TotalAmount.ToString("N0") đ
            </strong>
        </div>

    </div>

    <table class="detail-table">

        <thead>
            <tr>
                <th>MÃ SP</th>
                <th>SẢN PHẨM</th>
                <th>SỐ LƯỢNG</th>
                <th>GIÁ NHẬP</th>
                <th>THÀNH TIỀN</th>
            </tr>
        </thead>

        <tbody>

        @foreach (var detail in Model.Details)
        {
            <tr>

                <td>
                    @detail.Product?.Code
                </td>

                <td>
                    @detail.Product?.Name
                </td>

                <td>
                    @detail.Quantity
                </td>

                <td>
                    @detail.UnitPrice.ToString("N0") đ
                </td>

                <td>
                    @detail.Amount.ToString("N0") đ
                </td>

            </tr>
        }

        </tbody>

    </table>

    <div class="actions">

        <a asp-action="Index"
           class="btn-back">
            ← Danh sách phiếu nhập
        </a>

    </div>

</div>
