@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Quản lý kho</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #eaf4ff, #f8fbff);
        }

        .login-box {
            width: 420px;
            max-width: 92%;
            background: white;
            padding: 38px;
            border-radius: 18px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.12);
        }

        .logo {
            width: 68px;
            height: 68px;
            margin: 0 auto 18px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #2563eb;
            color: white;
            font-size: 32px;
        }

        h1 {
            text-align: center;
            font-size: 26px;
            color: #1e293b;
            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;
            color: #64748b;
            margin-bottom: 28px;
        }

        label {
            display: block;
            font-weight: 600;
            color: #334155;
            margin-bottom: 7px;
        }

        input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 9px;
            margin-bottom: 18px;
            font-size: 15px;
            outline: none;
        }

        input:focus {
            border-color: #2563eb;
        }

        button {
            width: 100%;
            border: none;
            padding: 13px;
            border-radius: 9px;
            background: #2563eb;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }

        button:hover {
            background: #1d4ed8;
        }

        .error {
            padding: 11px;
            margin-bottom: 18px;
            border-radius: 8px;
            background: #fee2e2;
            color: #b91c1c;
            font-size: 14px;
        }

        .footer {
            margin-top: 24px;
            text-align: center;
            color: #94a3b8;
            font-size: 13px;
        }
    </style>
</head>

<body>

<div class="login-box">

    <div class="logo">▣</div>

    <h1>QUẢN LÝ KHO</h1>

    <div class="subtitle">
        Đăng nhập để truy cập hệ thống
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="error">
            @ViewBag.Error
        </div>
    }

    <form asp-controller="Account"
          asp-action="Login"
          method="post">

        @Html.AntiForgeryToken()

        <label>Tên đăng nhập</label>

        <input type="text"
               name="username"
               placeholder="Nhập tên đăng nhập"
               autocomplete="username"
               required />

        <label>Mật khẩu</label>

        <input type="password"
               name="password"
               placeholder="Nhập mật khẩu"
               autocomplete="current-password"
               required />

        <button type="submit">
            Đăng nhập
        </button>

    </form>

    <div class="footer">
        Inventory Management System
    </div>

</div>

</body>
</html>
