@model InventoryManagement.Models.Supplier

@{
    ViewData["Title"] = "Thêm nhà cung cấp";
}

<style>
    .form-card {
        max-width: 820px;
        margin: auto;
        padding: 28px;
        background: white;
        border: 1px solid #e7e5e4;
        border-radius: 18px;
    }

    .form-title {
        margin-bottom: 5px;
        font-size: 18px;
        font-weight: 800;
    }

    .form-note {
        margin-bottom: 25px;
        color: #78716c;
        font-size: 12px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-label {
        display: block;
        margin-bottom: 7px;
        font-size: 12px;
        font-weight: 700;
    }

    .input {
        width: 100%;
        padding: 11px 13px;
        border: 1px solid #e7e5e4;
        border-radius: 10px;
        outline: none;
    }

    .input:focus {
        border-color: #c96f32;
    }

    .validation {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 11px;
    }

    .actions {
        display: flex;
        justify-content: flex-end;
        gap: 9px;
        margin-top: 10px;
    }

    .btn-back,
    .btn-save {
        padding: 10px 17px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
    }

    .btn-back {
        border: 1px solid #e7e5e4;
        color: #57534e;
    }

    .btn-save {
        border: none;
        background: #c96f32;
        color: white;
    }
</style>

<div class="form-card">

    <div class="form-title">
        Thông tin nhà cung cấp
    </div>

    <div class="form-note">
        Nhập thông tin đơn vị cung cấp hàng hóa cho kho.
    </div>

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div class="form-grid">

            <div class="form-group full-width">

                <label asp-for="Name"
                       class="form-label">
                    Tên nhà cung cấp *
                </label>

                <input asp-for="Name"
                       class="input"
                       placeholder="Ví dụ: Công ty ABC" />

                <span asp-validation-for="Name"
                      class="validation"></span>

            </div>

            <div class="form-group">

                <label asp-for="Phone"
                       class="form-label">
                    Số điện thoại
                </label>

                <input asp-for="Phone"
                       class="input"
                       placeholder="0987654321" />

                <span asp-validation-for="Phone"
                      class="validation"></span>

            </div>

            <div class="form-group">

                <label asp-for="Email"
                       class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="input"
                       placeholder="contact@example.com" />

                <span asp-validation-for="Email"
                      class="validation"></span>

            </div>

            <div class="form-group full-width">

                <label asp-for="Address"
                       class="form-label">
                    Địa chỉ
                </label>

                <input asp-for="Address"
                       class="input"
                       placeholder="Nhập địa chỉ nhà cung cấp" />

                <span asp-validation-for="Address"
                      class="validation"></span>

            </div>

        </div>

        <div class="actions">

            <a asp-action="Index"
               class="btn-back">
                Quay lại
            </a>

            <button type="submit"
                    class="btn-save">
                Lưu nhà cung cấp
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
