@model IEnumerable<InventoryManagement.Models.Category>

@{
    ViewData["Title"] = "Danh mục sản phẩm";
}

<style>
    .category-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
    }

    .search-form {
        display: flex;
        gap: 8px;
        flex: 1;
        max-width: 520px;
    }

    .search-input {
        flex: 1;
        padding: 10px 14px;
        border: 1px solid #e7e5e4;
        border-radius: 10px;
        outline: none;
    }

    .search-input:focus {
        border-color: #c96f32;
    }

    .btn-search,
    .btn-add {
        border: none;
        border-radius: 10px;
        padding: 10px 16px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-search {
        background: #292524;
        color: white;
    }

    .btn-add {
        background: #c96f32;
        color: white;
    }

    .btn-add:hover {
        background: #a65321;
        color: white;
    }

    .category-card {
        background: white;
        border: 1px solid #e7e5e4;
        border-radius: 16px;
        overflow: hidden;
    }

    .category-table {
        width: 100%;
        border-collapse: collapse;
    }

    .category-table th {
        background: #fafaf9;
        padding: 13px 16px;
        color: #78716c;
        font-size: 11px;
        text-align: left;
    }

    .category-table td {
        padding: 15px 16px;
        border-top: 1px solid #f5f5f4;
        font-size: 13px;
        vertical-align: middle;
    }

    .category-name {
        font-weight: 700;
        color: #292524;
    }

    .status-active,
    .status-inactive {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
    }

    .status-active {
        background: #f0fdf4;
        color: #15803d;
    }

    .status-inactive {
        background: #f5f5f4;
        color: #78716c;
    }

    .action-group {
        display: flex;
        gap: 7px;
    }

    .btn-edit,
    .btn-toggle {
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 11px;
        text-decoration: none;
        border: 1px solid #e7e5e4;
        background: white;
        color: #44403c;
        cursor: pointer;
    }

    .btn-edit:hover {
        border-color: #fed7aa;
        color: #c96f32;
    }

    .btn-toggle:hover {
        background: #fafaf9;
    }

    .alert-success-custom {
        padding: 12px 15px;
        margin-bottom: 18px;
        border-radius: 10px;
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
        font-size: 13px;
    }

    .empty-row {
        padding: 40px !important;
        text-align: center;
        color: #a8a29e;
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert-success-custom">
        ✓ @TempData["Success"]
    </div>
}

<div class="category-toolbar">

    <form method="get"
          asp-action="Index"
          class="search-form">

        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="search-input"
               placeholder="Tìm kiếm tên danh mục..." />

        <button type="submit"
                class="btn-search">
            Tìm kiếm
        </button>

    </form>

    <a asp-action="Create"
       class="btn-add">
        + Thêm danh mục
    </a>

</div>

<div class="category-card">

    <table class="category-table">

        <thead>
            <tr>
                <th style="width: 70px;">ID</th>
                <th>TÊN DANH MỤC</th>
                <th>MÔ TẢ</th>
                <th>TRẠNG THÁI</th>
                <th>NGÀY TẠO</th>
                <th style="width: 190px;">THAO TÁC</th>
            </tr>
        </thead>

        <tbody>

        @if (!Model.Any())
        {
            <tr>
                <td colspan="6"
                    class="empty-row">
                    Chưa có danh mục sản phẩm.
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        #@item.Id
                    </td>

                    <td class="category-name">
                        @item.Name
                    </td>

                    <td>
                        @(string.IsNullOrWhiteSpace(item.Description)
                            ? "-"
                            : item.Description)
                    </td>

                    <td>
                        @if (item.IsActive)
                        {
                            <span class="status-active">
                                Đang sử dụng
                            </span>
                        }
                        else
                        {
                            <span class="status-inactive">
                                Ngừng sử dụng
                            </span>
                        }
                    </td>

                    <td>
                        @item.CreatedAt.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        <div class="action-group">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn-edit">
                                Sửa
                            </a>

                            <form asp-action="ToggleStatus"
                                  asp-route-id="@item.Id"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn-toggle">

                                    @(item.IsActive
                                        ? "Ngừng dùng"
                                        : "Kích hoạt")

                                </button>

                            </form>

                        </div>
                    </td>

                </tr>
            }
        }

        </tbody>

    </table>

</div>
